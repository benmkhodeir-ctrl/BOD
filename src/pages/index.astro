---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandMark from '../components/BrandMark.astro';
import StoryCard from '../components/StoryCard.astro';
import ContextualCTA from '../components/ContextualCTA.astro';
const writing = (await getCollection('writing')).sort((a,b) => b.data.published.valueOf() - a.data.published.valueOf());
const featured = writing.find(x => x.data.featured) || writing[0];
const latest = writing.filter(x => x.id !== featured?.id).slice(0,3);
const lastInch = writing.filter(x => x.data.series === 'the-last-inch').slice(0,3);
const process = writing.filter(x => x.data.series === 'the-process-broke-here').slice(0,2);
const fieldNotes = writing.filter(x => x.data.format === 'field-note').slice(0,3);
const storyHref = (e) => e.data.format === 'field-note' ? `/field-notes/${e.id}` : `/articles/${e.id}`;
---
<BaseLayout description="Real-world observations on parcel delivery, apartment operations, systems, behaviour, process and practical technology.">
  <section class="home-hero">
    <div class="shell hero-grid">
      <div>
        <div class="section-kicker">BEN ON DELIVERY</div>
        <h1>THE POINT WHERE<br/>THE SYSTEM<br/><span>MEETS REALITY.</span></h1>
        <p>Real-world observations on parcel delivery, apartment operations, systems, behaviour, process and practical technology.</p>
        {featured && <a class="text-link" href={storyHref(featured)}>Read the latest →</a>}
      </div>
      <BrandMark class="hero-mark" />
    </div>
  </section>

  {featured && <section class="section shell featured-story">
    <div class="section-kicker">Featured</div>
    <div class="featured-grid">
      <div class="feature-visual"><BrandMark /></div>
      <div>
        <div class="eyebrow">{featured.data.series.replaceAll('-', ' ')}</div>
        <h2>{featured.data.title}</h2>
        <p>{featured.data.standfirst}</p>
        <a class="text-link" href={storyHref(featured)}>Read article →</a>
      </div>
    </div>
  </section>}

  <section class="section shell">
    <div class="section-heading"><div><div class="section-kicker">Latest</div><h2>What I’m looking at.</h2></div><a href="/articles">All articles →</a></div>
    <div class="cards-grid">{latest.map(entry => <StoryCard entry={entry} />)}</div>
  </section>

  <section class="section section-dark">
    <div class="shell">
      <div class="section-heading"><div><div class="section-kicker">The Last Inch</div><h2>Where a sound system meets actual use.</h2></div><a href="/the-last-inch">Explore →</a></div>
      <div class="cards-grid">{lastInch.map(entry => <StoryCard entry={entry} />)}</div>
    </div>
  </section>

  <section class="section shell">
    <div class="section-heading"><div><div class="section-kicker">The Process Broke Here</div><h2>Find the point that actually changed the outcome.</h2></div><a href="/the-process-broke-here">Explore →</a></div>
    <div class="cards-grid two">{process.map(entry => <StoryCard entry={entry} />)}</div>
  </section>

  <section class="section shell">
    <div class="section-heading"><div><div class="section-kicker">Field Notes</div><h2>Short observations from the field.</h2></div><a href="/field-notes">All field notes →</a></div>
    <div class="cards-grid">{fieldNotes.map(entry => <StoryCard entry={entry} />)}</div>
  </section>

  <section class="section shell about-strip">
    <div><div class="section-kicker">About Ben</div><h2>I’m interested in what actually happens.</h2></div>
    <div><p>I’m an operator who spends a lot of time looking at the handoffs between people, processes, technology and physical environments. BEN ON DELIVERY is where I work through what I’m seeing and what it might mean.</p><a class="text-link" href="/about">About Ben →</a></div>
  </section>

  <section class="section shell-reading"><ContextualCTA /></section>
</BaseLayout>
