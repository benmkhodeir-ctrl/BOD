---
const { mode = 'general', source = Astro.url.pathname } = Astro.props;
const copy = mode === 'commercial'
  ? {
      kicker: 'Something worth talking about?',
      title: 'Looking at a similar problem?',
      body: "If you're thinking about parcel delivery in an existing building, a new development or across a portfolio, send me a note."
    }
  : {
      kicker: 'Something worth talking about?',
      title: 'Continue the conversation.',
      body: "Parcel delivery, an article, media, an introduction, a collaboration or something completely different. Send me a note."
    };
---
<section class="contextual-cta">
  <div class="section-kicker">{copy.kicker}</div>
  <h2>{copy.title}</h2>
  <p>{copy.body}</p>
  <a class="text-link" href={`/contact?from=${encodeURIComponent(source)}`}>Get in touch →</a>
</section>
