---
const { pageId, pageTitle } = Astro.props;
const appId = import.meta.env.PUBLIC_CUSDIS_APP_ID;
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
---

<section class="comments-block" id="comments">
  <div class="section-kicker">Join the conversation</div>
  <h2>What have I missed?</h2>
  <p>Use your name and email. Your email stays private. Comments are moderated before publication.</p>

  {appId ? (
    <>
      <div
        id="cusdis_thread"
        data-host="https://cusdis.com"
        data-app-id={appId}
        data-page-id={pageId}
        data-page-url={pageUrl}
        data-page-title={pageTitle}
      ></div>
      <script async defer src="https://cusdis.com/js/cusdis.es.js"></script>
    </>
  ) : (
    <div class="comments-placeholder">
      <strong>Comments are ready to connect.</strong>
      <p>Add <code>PUBLIC_CUSDIS_APP_ID</code> to the Cloudflare Pages environment variables, then rebuild the site.</p>
    </div>
  )}
</section>
