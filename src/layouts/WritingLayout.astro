---
import ShareArticle from '../components/ShareArticle.astro';
import BaseLayout from './BaseLayout.astro';
import ContextualCTA from '../components/ContextualCTA.astro';
import Comments from '../components/Comments.astro';
const { entry } = Astro.props;
const d = entry.data;
const seriesLabels = {
  'the-last-inch': 'The Last Inch',
  'the-process-broke-here': 'The Process Broke Here',
  'general': d.format === 'field-note' ? 'Field Note' : 'Article'
};
const canonicalPath = d.format === 'field-note' ? `/field-notes/${entry.id}` : `/articles/${entry.id}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': d.format === 'field-note' ? 'BlogPosting' : 'Article',
  headline: d.title,
  description: d.standfirst,
  datePublished: d.published.toISOString(),
  dateModified: (d.updated || d.published).toISOString(),
  author: { '@type': 'Person', name: 'Ben Khodeir' },
  publisher: { '@type': 'Organization', name: 'BEN ON DELIVERY' },
  mainEntityOfPage: new URL(canonicalPath, Astro.site || Astro.url.origin).toString()
};
---
<BaseLayout title={d.title} description={d.standfirst} image={d.heroImage} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="writing-page">
    <header class="writing-header shell-narrow">
      <div class="eyebrow">{seriesLabels[d.series]} · {d.published.toLocaleDateString('en-AU')}</div>
      {d.status === 'prototype' && <div class="prototype-badge">Prototype copy for layout testing</div>}
      <h1>{d.title}</h1>
      <p class="standfirst">{d.standfirst}</p>
      <div class="byline">By Ben Khodeir</div>
    </header>
    {d.heroImage && (
      <figure class="hero-evidence shell">
        <img src={d.heroImage} alt={d.heroAlt || ''} />
        {d.heroCaption && <figcaption>{d.heroCaption}</figcaption>}
      </figure>
    )}
    <div class="article-body shell-reading"><slot /></div>
  </article>
<div class="shell-reading">
  <ShareArticle
    title={d.title}
    url={new URL(canonicalPath, Astro.site || Astro.url.origin).toString()}
    label={d.format === 'field-note' ? 'Share this field note' : 'Share this article'}
  />
</div>
  {d.contactPrompt !== 'none' && <div class="shell-reading"><ContextualCTA mode={d.contactPrompt} source={canonicalPath} /></div>}

  {d.discussion && <section class="social-discussion shell-reading">
    <div class="section-kicker">Continue the conversation</div>
    <div class="discussion-links">
      {d.discussion.linkedin && <a href={d.discussion.linkedin} rel="noreferrer">LinkedIn</a>}
      {d.discussion.facebook && <a href={d.discussion.facebook} rel="noreferrer">Facebook</a>}
      {d.discussion.x && <a href={d.discussion.x} rel="noreferrer">X</a>}
    </div>
  </section>}

  <div class="shell-reading"><Comments pageId={`bod:${entry.id}`} pageTitle={d.title} /></div>

  <section class="author-block shell-reading">
    <div class="section-kicker">About Ben</div>
    <h2>Ben Khodeir</h2>
    <p>I’m an operator interested in what happens when systems, technology, processes, people and physical environments meet the real world.</p>
    <a class="text-link" href="/about">About Ben →</a>
  </section>
</BaseLayout>
